{
  "name": "awesome-list-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "verify:version": "node scripts/verify-version.mjs",
    "lint:extension": "addons-linter web-ext-artifacts/*.zip",
    "build:archive": "node scripts/package-extension.mjs",
    "package:extension": "npm run verify:version && npm run typecheck && npm run build && npm run build:archive && npm run lint:extension"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "addons-linter": "^10.6.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
